# ── 拾光旅伴 H5 环境变量示例 ──────────────────────────────────────────
# 复制此文件为 .env.local 并填入真实值（.env.local 不提交到版本库）

# Supabase（已预置，勿修改）
VITE_SUPABASE_URL=https://backend.appmiaoda.com/projects/supabase335322080675414016
VITE_SUPABASE_ANON_KEY=<your_anon_key>

# ── TURN 服务器配置（B1-T WebRTC 跨网测试）──────────────────────────
# 留空时应用仍可运行，但仅限局域网/可直连测试，页面会显示「TURN 未配置」提示。
#
# VITE_TURN_URLS
#   逗号分隔的完整 TURN URL 列表，支持 UDP / TCP / TLS：
#   示例：turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
#   注意：不要写入永久长期密钥；请使用 TURN 服务器的临时（time-limited）凭据。
VITE_TURN_URLS=

# VITE_TURN_USERNAME
#   TURN 临时用户名（由 TURN 服务端动态生成，通常含时间戳）
VITE_TURN_USERNAME=

# VITE_TURN_CREDENTIAL
#   TURN 临时密码（与 VITE_TURN_USERNAME 对应的 HMAC-SHA1 摘要或临时密码）
VITE_TURN_CREDENTIAL=

# ── 调试参数（URL 查询参数，非环境变量）─────────────────────────────
# ?rtcRelay=1   — 强制 iceTransportPolicy:'relay'（验证 TURN 是否生效）
# ?demo         — （开发模式）注入演示房间数据

# 微信公众号 AppID（网页 OAuth 授权，可选）
VITE_WECHAT_APPID=
VITE_APP_ID=app-d04hti6zlz42
