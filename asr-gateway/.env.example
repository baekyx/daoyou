# 服务配置
PORT=8080
NODE_ENV=production
ENABLE_TEST_PAGE=false

# 百度实时语音识别：服务端 Secret，严禁使用 VITE_ 前缀
BAIDU_SPEECH_APP_ID=
BAIDU_SPEECH_API_KEY=

# 逗号分隔。生产必须明确填写秒哒正式域名和预览域名。
ALLOWED_ORIGINS=https://app-dgh89h0lz9j5.appmiaoda.com,https://app-dgh89h0lz9j5-vitesandbox.miaoda.cn

# 保护百度额度的基础限制
MAX_CONNECTIONS=40
MAX_CONNECTIONS_PER_IP=4
MAX_SESSION_SECONDS=3600
MAX_PENDING_AUDIO_BYTES=320000
